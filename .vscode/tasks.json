{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Easy Block Pallets: Build",
      "type": "process",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": [
        "--no-daemon",
        "--no-parallel",
        "build",
        "--console=plain"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "GRADLE_USER_HOME": "${workspaceFolder}\\.gradle-easyblockpallets"
        }
      },
      "group": "build",
      "problemMatcher": "$gradle",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Easy Block Pallets: Run NeoForge Client",
      "type": "process",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": [
        "--no-daemon",
        "--no-parallel",
        "runClient",
        "--console=plain"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "GRADLE_USER_HOME": "${workspaceFolder}\\.gradle-easyblockpallets"
        }
      },
      "group": "test",
      "problemMatcher": "$gradle",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
